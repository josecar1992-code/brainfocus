PORT=3001
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Origen(es) permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,https://app.focusbraincr.com
# Solo estos correos pueden usar la app como dueño (JWT), separados por coma.
# Vacío = sin restricción. No bloquea el registro en sí (eso es config de
# Supabase Auth), pero la API rechaza con 403 a cualquier otro correo.
ALLOWED_EMAILS=josecar1992@gmail.com
# Gateway de OpenClaw (tool `cron` sobre POST /tools/invoke) para el aviso
# real de WhatsApp/Telegram de los recordatorios. Opcionales: sin ellos, los
# recordatorios se guardan y se ven en la app pero no se disparan solos (ver
# src/services/openclawCron.ts). El token sale de /root/.openclaw/openclaw.json
# en el VPS de OpenClaw (169.58.62.116) — NO se pega en este repo ni en git,
# solo en el .env real del servidor donde corre apps/api.
# OpenClaw corre nativo por systemd (no Docker) — usar host.docker.internal,
# no 127.0.0.1, porque api sí corre en un contenedor Docker normal (requiere
# el extra_hosts de docker-compose.yml + un ufw allow a la subred del stack).
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
# Único destinatario (app de un solo dueño), sin prefijo de canal.
OPENCLAW_REMINDER_TO=+50600000000
